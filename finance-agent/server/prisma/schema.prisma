// Schéma de données de l'agent financier.
// Basé sur la spécification du projet, avec quelques ajouts :
// - réglages d'alertes par utilisateur (jours de rappel, seuil budget, canaux)
// - catégorie SUBSCRIPTION (Netflix, Spotify...)
// - récurrence des factures (création automatique de l'échéance suivante)
// - clé de déduplication des notifications (un rappel n'est envoyé qu'une fois)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String          @id @default(cuid())
  email                  String          @unique
  passwordHash           String
  name                   String?
  // Jours avant échéance déclenchant un rappel (0 = le jour même)
  billReminderDays       Int[]           @default([7, 3, 0])
  // Pourcentage du budget à partir duquel on alerte
  budgetWarningThreshold Int             @default(80)
  notifyEmail            Boolean         @default(true)
  notifyInApp            Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  bills                  Bill[]
  budgets                Budget[]
  documents              AdminDocument[]
  notifications          Notification[]
}

model Bill {
  id          String       @id @default(cuid())
  userId      String
  title       String
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime     @db.Date
  paid        Boolean      @default(false)
  paidDate    DateTime?    @db.Date
  category    BillCategory
  provider    String
  reference   String?
  documentUrl String?
  notes       String?
  recurrence  Recurrence   @default(NONE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, paid])
}

enum BillCategory {
  HOUSING       // Loyer, charges
  UTILITIES     // EDF, gaz, eau
  INTERNET      // Internet, téléphone
  INSURANCE     // Assurance auto/habitation
  TRANSPORT     // Carburant, péages
  FOOD          // Alimentation
  HEALTH        // Santé
  ENTERTAINMENT // Loisirs
  SUBSCRIPTION  // Abonnements (Netflix, Spotify...)
  OTHER         // Autres
}

enum Recurrence {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

model Budget {
  id          String       @id @default(cuid())
  userId      String
  category    BillCategory
  limitAmount Decimal      @db.Decimal(12, 2)
  month       Int          // Mois (1-12)
  year        Int
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
}

model AdminDocument {
  id           String       @id @default(cuid())
  userId       String
  title        String
  description  String?
  documentType DocumentType
  dueDate      DateTime?    @db.Date
  isCompleted  Boolean      @default(false)
  fileUrl      String?
  notes        String?
  createdAt    DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DocumentType {
  TAX          // Impôts
  INSURANCE    // Assurance
  CONTRACT     // Contrats
  CERTIFICATE  // Certificats
  RECEIPT      // Reçus
  OTHER        // Autres
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  dueDate   DateTime?        @db.Date
  billId    String?
  // Empêche d'envoyer deux fois le même rappel (ex. "bill:<id>:7:<date>")
  dedupKey  String?          @unique
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  BILL_REMINDER // Rappel facture
  BUDGET_ALERT  // Alerte budget
  ADMIN_TASK    // Tâche administrative
  GENERAL       // Général
}
