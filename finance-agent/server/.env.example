DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
JWT_SECRET=change-me-with-a-long-random-string
PORT=3000
# Fuseau utilisé pour calculer "aujourd'hui" (rappels J-7, J-3, jour J)
TZ_NAME=Europe/Paris
# Origine autorisée pour le frontend en dev
CORS_ORIGIN=http://localhost:5173
# Intervalle du planificateur de rappels, en minutes
REMINDER_INTERVAL_MINUTES=60
# Envoi d'emails (optionnel : sans SMTP_HOST, les emails sont journalisés)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agent financier <no-reply@example.com>"
