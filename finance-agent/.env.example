# Copiez ce fichier en .env avant `docker compose up`
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
POSTGRES_PASSWORD=finance
TZ_NAME=Europe/Paris
# SMTP facultatif : sans lui, les emails de rappel sont seulement journalisés
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Agent financier <no-reply@example.com>
