{
  "name": "bureau",
  "version": "1.0.0",
  "private": true,
  "description": "Le Bureau : une équipe d'agents Claude Code qui travaille sous tes yeux, en pixel art.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite build --logLevel warn && tsx server/index.ts",
    "setup": "tsx server/setup.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "modele": "tsx server/telecharger-modele.ts",
    "micros": "tsx server/micros.ts",
    "reveiller": "bash scripts/reveiller-max.sh",
    "arreter": "bash scripts/arreter-bureau.sh",
    "voix": "tsx server/installer-voix.ts",
    "voix-humaine": "tsx server/choisir-voix.ts",
    "voix-xtts": "tsx server/installer-xtts.ts",
    "ia-locale": "tsx server/ia-locale.ts",
    "musique": "tsx server/changer-musique.ts",
    "claque": "tsx server/claque.ts",
    "claque-installer": "bash scripts/claque-service.sh installer",
    "claque-desinstaller": "bash scripts/claque-service.sh desinstaller",
    "compagnon": "vite build --logLevel warn && tsx server/compagnon/index.ts",
    "appel": "tsx server/appel-essai.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vladmandic/face-api": "^1.7.15",
    "exceljs": "^4.4.0",
    "phaser": "^3.90.0",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "vite": "^5.4.21",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
